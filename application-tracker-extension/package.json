{
  "name": "application-tracker-extension",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-tests.mjs && node scripts/job-info-browser-tests.mjs && node scripts/component-browser-tests.mjs && node scripts/choice-browser-tests.mjs && node scripts/date-format-browser-tests.mjs && node scripts/scan-context-browser-tests.mjs",
    "test:components": "node scripts/component-browser-tests.mjs",
    "test:extension": "node scripts/extension-tests.mjs",
    "test:ui": "node scripts/ui-tests.mjs",
    "test:data-ui": "node scripts/data-ui-tests.mjs",
    "test:vision-browser": "node scripts/vision-browser-tests.mjs",
    "test:real-pages": "node scripts/real-page-tests.mjs",
    "test:slow": "node scripts/scan-scaling-check.mjs && node scripts/slow-cpu-date-check.mjs"
  },
  "devDependencies": {
    "antd3": "npm:antd@3.26.20",
    "antd5": "npm:antd@5.29.3",
    "dayjs": "1.11.19",
    "element-ui": "2.15.14",
    "moment": "2.30.1",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "vue": "2.7.16"
  }
}
